{
  "manifest_version": 3,
  "name": "ChatGPT Card Manager",
  "version": "1.17.0",
  "description": "Manage ChatGPT conversations with card previews, local cache, search, batch actions, media viewing, and smooth FLIP animations.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "permissions": []
}
